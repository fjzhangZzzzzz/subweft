# Copy to a restricted runtime.env outside Git; this file has no real credentials.
SUBWEFT_BASE_URL=https://subscriptions.example.com
SUBWEFT_OIDC_ISSUER=https://id.example.com
SUBWEFT_OIDC_CLIENT_ID=replace-with-registered-client-id
SUBWEFT_ADMIN_SUBJECTS=replace-with-exact-oidc-sub
# GeoDB is supplied by deployment; the editor never downloads it.
# Set SUBWEFT_GEODB_DIR to a read-only directory inside your container when using GEOIP.
