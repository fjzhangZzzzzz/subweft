{
  "name": "subweft-web",
  "version": "0.1.0-dev",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "dev": "vite --host 127.0.0.1",
    "format": "prettier --write src index.html vite.config.ts tsconfig.json package.json",
    "format:check": "prettier --check src index.html vite.config.ts tsconfig.json package.json"
  },
  "dependencies": {
    "diff": "9.0.0",
    "lucide-react": "1.62.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
